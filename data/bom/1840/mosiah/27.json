    "chapter": 27,
    "verse": 23,
    "lines": [
      {
        "id": "212:3a",
        "page": 212,
        "line": 3,
        "text": "And it came pass after they had fasted and prayed for the space of two days and two nights, the limbs of Alma received their strength, and he stood up and began to speak unto them, bidding them to be of good comfort;",
        "source": "https://www.josephsmithpapers.org/paper-summary/book-of-mormon-1840/212"
      }
    ]
  },
