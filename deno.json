{
  "unstable": ["kv"],
  "nodeModulesDir": "manual",
  "tasks": {
    "setup": "git config core.hooksPath .githooks && chmod +x .githooks/pre-commit .githooks/pre-push",
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test -A",
    "bench": "deno bench --allow-read **/*.bench.ts",
    "pre-commit": "deno task check && deno task test",
    "pre-push": "deno task check && deno task test",
    "dev": "deno run --env-file -A npm:vite",
    "build": "vite build",
    "preview": "deno task build && deno task start",
    "start": "deno serve --env-file -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "build:stats": "deno run -A scripts/build-variant-stats.ts",
    "align:pm": "deno run -A scripts/align-source.ts pm",
    "align:om": "deno run -A scripts/align-source.ts om",
    "align:1830": "deno run -A scripts/align-source.ts 1830",
    "align:1837": "deno run -A scripts/align-source.ts 1837",
    "align:1840": "deno run -A scripts/align-source.ts 1840",
    "align:1841": "deno run -A scripts/align-source.ts 1841",
    "report:om": "deno run -A scripts/align-report.ts om",
    "report:pm": "deno run -A scripts/align-report.ts pm",
    "report:1830": "deno run -A scripts/align-report.ts 1830",
    "report:1837": "deno run -A scripts/align-report.ts 1837",
    "report:1840": "deno run -A scripts/align-report.ts 1840",
    "report:1841": "deno run -A scripts/align-report.ts 1841"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".claude/"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.3",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@types/node": "npm:@types/node@^22",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@^2.6.2",
    "vite-plugin-pwa": "npm:vite-plugin-pwa@^0.21.1",
    "workbox-core": "npm:workbox-core@^7.3.0",
    "workbox-precaching": "npm:workbox-precaching@^7.3.0",
    "workbox-routing": "npm:workbox-routing@^7.3.0",
    "workbox-strategies": "npm:workbox-strategies@^7.3.0",
    "workbox-broadcast-update": "npm:workbox-broadcast-update@^7.3.0",
    "workbox-expiration": "npm:workbox-expiration@^7.3.0"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template",
      "span"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "jakeave",
    "app": "book-of-mormon-compare"
  }
}
