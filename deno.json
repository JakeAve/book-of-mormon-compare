{
  "unstable": ["kv"],
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "test": "deno test -A",
    "pre-commit": "deno task check && deno task test",
    "pre-push": "deno task check && deno task test",
    "dev": "vite",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update .",
    "align:om": "deno run -A scripts/align-source.ts om",
    "align:pm": "deno run -A scripts/align-source.ts pm",
    "align:1830": "deno run -A scripts/align-source.ts 1830",
    "align:1837": "deno run -A scripts/align-source.ts 1837"
  },
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*"
  ],
  "imports": {
    "@/": "./",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "vite": "npm:vite@^7.1.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "tailwindcss": "npm:tailwindcss@^4.1.10",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.1.12",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@resvg/resvg-wasm": "npm:@resvg/resvg-wasm@^2.6.2"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template",
      "span"
    ],
    "types": [
      "vite/client"
    ]
  },
  "deploy": {
    "org": "jakeave",
    "app": "book-of-mormon-compare"
  }
}
